{
  "name": "pawchive-pro",
  "version": "1.0.0",
  "description": "Batch downloader for Kemono / Pawchive creator posts. Derived from PixivBatchDownloader and Kemono-Downloader.",
  "author": "PawchivePro contributors",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddd000987/PawchivePro.git"
  },
  "homepage": "https://github.com/ddd000987/PawchivePro#readme",
  "bugs": {
    "url": "https://github.com/ddd000987/PawchivePro/issues"
  },
  "scripts": {
    "ts": "webpack --config ./webpack.conf.js",
    "ts:prod": "webpack --config ./webpack.conf.js --mode production",
    "less": "lessc ./src/style/style.less ./dist/style/style.css",
    "pack": "node ./scripts/pack.js",
    "make-icons": "node ./scripts/make-icons.js",
    "build": "npm run ts:prod && npm run less && npm run pack",
    "build:dev": "npm run ts && npm run less && npm run pack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "0.0.277",
    "@types/node": "^22.7.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "less": "^4.2.0",
    "prettier": "^3.9.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
